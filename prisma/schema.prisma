// Cashflow data model.
// Entries hold a recurrence as an RFC 5545 RRULE string (rrule.js compatible).
// Projection engine expands entries -> events[] -> balance series[] at read time.
// Anchor is the user's known balance at a point in time; series projects forward from it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  anchor  Anchor?
  entries Entry[]
  tags    Tag[]
}

model Anchor {
  id           String   @id @default(cuid())
  userId       String   @unique
  balance      Float
  asOf         DateTime
  accountLabel String?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // "IN" | "OUT" — SQLite has no native enums via Prisma; constrain in app
  name      String
  amount    Float    // major units (USD for v1)
  currency  String   @default("USD")
  startDate DateTime // ISO date; time component ignored (PlainDate)
  endDate   DateTime?
  rrule     String?  // RFC 5545 RRULE string; null = one-time at startDate
  paused    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags Tag[]

  @@index([userId])
}

model Tag {
  id      String  @id @default(cuid())
  userId  String
  name    String
  entries Entry[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}
