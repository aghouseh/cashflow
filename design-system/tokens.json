{
  "$schema": "https://design-tokens.org/v1",
  "name": "cashflow",
  "version": "1.0.0",
  "description": "Cashflow micro design system — neutral / accent / semantic, each a base·ink·soft triad.",
  "defaults": { "accent": "indigo", "neutral": "warm" },

  "neutral": {
    "warm": {
      "bg": "#faf9f5",
      "surface": "#ffffff",
      "surface-2": "#f4f3ee",
      "ink": "#1a1a17",
      "ink-2": "#56554e",
      "ink-3": "#8d8b82",
      "ink-4": "#c3c1b7",
      "line": "#eae8e1",
      "line-2": "#d8d5cc"
    },
    "cool": {
      "bg": "#f7f8f9",
      "surface": "#ffffff",
      "surface-2": "#eef1f3",
      "ink": "#17191c",
      "ink-2": "#4e5258",
      "ink-3": "#868a91",
      "ink-4": "#c0c4ca",
      "line": "#e6e8ec",
      "line-2": "#d3d7dd"
    }
  },

  "accent": {
    "indigo": { "base": "oklch(0.55 0.15 262)", "ink": "oklch(0.42 0.12 262)", "soft": "oklch(0.955 0.028 262)", "on": "#ffffff" },
    "teal":   { "base": "oklch(0.58 0.10 195)", "ink": "oklch(0.44 0.08 195)", "soft": "oklch(0.955 0.030 195)", "on": "#ffffff" },
    "violet": { "base": "oklch(0.55 0.16 295)", "ink": "oklch(0.42 0.13 295)", "soft": "oklch(0.955 0.033 295)", "on": "#ffffff" },
    "clay":   { "base": "oklch(0.60 0.12 45)",  "ink": "oklch(0.45 0.10 45)",  "soft": "oklch(0.955 0.033 45)",  "on": "#ffffff" },
    "bronze": { "base": "oklch(0.66 0.10 75)",  "ink": "oklch(0.45 0.08 72)",  "soft": "oklch(0.95 0.035 80)",   "on": "oklch(0.28 0.06 70)" },
    "slate":  { "base": "oklch(0.46 0.025 255)","ink": "oklch(0.32 0.02 255)", "soft": "oklch(0.93 0.012 255)",  "on": "#ffffff" }
  },

  "semantic": {
    "in":  { "base": "oklch(0.56 0.09 155)", "ink": "oklch(0.43 0.07 155)", "soft": "oklch(0.95 0.03 155)" },
    "out": { "base": "oklch(0.57 0.13 27)",  "ink": "oklch(0.44 0.10 27)",  "soft": "oklch(0.96 0.03 27)" }
  },

  "type": {
    "font-sans": "Geist, -apple-system, system-ui, sans-serif",
    "font-mono": "Geist Mono, ui-monospace, JetBrains Mono, Menlo, monospace",
    "scale": {
      "display":    { "font": "mono", "size": "56px", "tracking": "-0.025em", "weight": 400 },
      "display-sm": { "font": "mono", "size": "28px", "tracking": "-0.018em", "weight": 400 },
      "h1":         { "font": "sans", "size": "18-22px", "weight": 500 },
      "h2":         { "font": "sans", "size": "14.5px", "weight": 500 },
      "body":       { "font": "sans", "size": "13.5px", "weight": 400 },
      "micro":      { "font": "mono", "size": "10px", "tracking": "0.09em", "transform": "uppercase", "weight": 500, "color": "ink-3" }
    },
    "numeric": "tabular-nums / font-feature-settings: \"tnum\""
  },

  "radius": { "card": "14px", "control": "9px", "pill": "999px" },

  "elevation": {
    "modal": "0 12px 40px rgba(0,0,0,.18)",
    "lift": "0 3px 8px rgba(0,0,0,.22)",
    "ring-halo": "0 0 0 3px <surface>"
  }
}
